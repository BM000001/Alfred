{
  "name": "alfred",
  "version": "0.1.0",
  "private": true,
  "description": "Assistente pessoal de produtividade e estudos, local-first e com foco em privacidade.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:js": "tsc -p tsconfig.json",
    "build:site": "node scripts/build-site.mjs",
    "build": "npm run build:js && npm run build:site",
    "test:compile": "tsc -p tsconfig.test.json",
    "test": "npm run test:compile && node --test \"dist-test/tests/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "~25.6.0",
    "typescript": "~6.0.3"
  }
}
